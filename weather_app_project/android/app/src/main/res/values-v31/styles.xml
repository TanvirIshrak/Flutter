<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12+ system splash screen (SplashScreen API). -->
    <style name="LaunchTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:windowSplashScreenBackground">@android:color/white</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/app_logo</item>
        <item name="android:windowSplashScreenAnimationDuration">200</item>
    </style>
</resources>
